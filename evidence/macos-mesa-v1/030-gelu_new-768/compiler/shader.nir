shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    32x3   %2 = @load_global_invocation_id
    32     %3 = load_const (0x00000300 = 768)
    1      %4 = ult %2.x, %3 (0x300)
                // succs: b1 b2
    if %4 {
        block b1:   // preds: b0
        32     %5 = load_const (0x00000002)
        64     %6 = u2u64 %2.x
        64     %7 = ishl %6, %5 (0x2)
        64     %8 = iadd %1, %7
        32     %9 = @load_global (%8) (access=none, align_mul=4, align_offset=0)
        32    %10 = fmul %9, %9
        32    %11 = fmul %10, %9
        32    %12 = load_const (0x3d372713 = 0.044715)
        32    %13 = ffma %11, %12 (0.044715), %9
        32    %14 = load_const (0x3f800000 = 1.000000)
        32    %15 = load_const (0xc0135761 = -2.302208)
        32    %16 = fmul %13, %15 (-2.302208)
        32    %17 = fexp2 %16
        32    %18 = fadd %14 (1.000000), %17
        32    %19 = frcp %18
        32    %20 = fmul %9, %19
        64    %21 = iadd %0, %7
                    @store_global (%20, %21) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b3
    } else {
        block b2:  // preds: b0, succs: b3
    }
    block b3:  // preds: b1 b2, succs: b4
    block b4:
}

