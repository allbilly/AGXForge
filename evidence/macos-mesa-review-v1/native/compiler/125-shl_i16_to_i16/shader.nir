shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    64     %2 = @load_preamble (base=8)
    32x3   %3 = @load_global_invocation_id
    32     %4 = load_const (0x00000081 = 129)
    1      %5 = ult %3.x, %4 (0x81)
                // succs: b1 b2
    if %5 {
        block b1:   // preds: b0
        32     %6 = load_const (0x00000001)
        64     %7 = u2u64 %3.x
        64     %8 = ishl %7, %6 (0x1)
        64     %9 = iadd %1, %8
        16    %10 = @load_global (%9) (access=none, align_mul=2, align_offset=0)
        32    %11 = load_const (0x00000002)
        64    %12 = ishl %7, %11 (0x2)
        64    %13 = iadd %2, %12
        32    %14 = @load_global (%13) (access=none, align_mul=4, align_offset=0)
        32    %15 = load_const (0x0000007f = 127)
        32    %16 = iand %14, %15 (0x7f)
        32    %17 = u2u32 %10
        32    %18 = ishl %17, %16
        32    %19 = load_const (0x00000000)
        32    %20 = load_const (0x00000020 = 32)
        1     %21 = ult %16, %20 (0x20)
        32    %22 = bcsel %21, %18, %19 (0x0)
        16    %23 = u2u16 %22
        64    %24 = iadd %0, %8
                    @store_global (%23, %24) (wrmask=x, access=none, align_mul=2, align_offset=0)
                    // succs: b3
    } else {
        block b2:  // preds: b0, succs: b3
    }
    block b3:  // preds: b1 b2, succs: b4
    block b4:
}

