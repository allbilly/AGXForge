shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    64     %2 = @load_preamble (base=8)
    64     %3 = @load_preamble (base=12)
    32x3   %4 = @load_global_invocation_id
    32     %5 = load_const (0x00000080 = 128)
    1      %6 = ult %4.x, %5 (0x80)
                // succs: b1 b7
    if %6 {
        block b1:   // preds: b0
        32     %7 = load_const (0x00000000 = 0.000000)
        32     %8 = load_const (0x00000380 = 896)
        32     %9 = imul %4.x, %8 (0x380)
                    // succs: b2
        loop {
            block b2:   // preds: b1 b5
            32    %10 = phi b1: %7 (0x0), b5: %26
            32    %11 = phi b1: %7 (0x0), b5: %27
            32    %12 = iadd %9, %11
            32    %13 = load_const (0x00000001)
            64    %14 = u2u64 %12
            64    %15 = ishl %14, %13 (0x1)
            64    %16 = iadd %2, %15
            16    %17 = @load_global (%16) (access=none, align_mul=2, align_offset=0)
            32    %18 = load_const (0x00000002)
            64    %19 = u2u64 %11
            64    %20 = ishl %19, %18 (0x2)
            64    %21 = iadd %1, %20
            32    %22 = @load_global (%21) (access=none, align_mul=4, align_offset=0)
            32    %23 = load_const (0x00000010 = 16)
            32    %24 = u2u32 %17
            32    %25 = ishl %24, %23 (0x10)
            32    %26 = ffma %25, %22, %10
            32    %27 = iadd %11, %13 (0x1)
            1     %28 = uge %27, %8 (0x380)
                        // succs: b3 b4
            if %28 {
                block b3:// preds: b2
                break
                // succs: b6
            } else {
                block b4:  // preds: b2, succs: b5
            }
            block b5:  // preds: b4, succs: b2
        }
        block b6:   // preds: b3
        64    %29 = u2u64 %4.x
        64    %30 = ishl %29, %13 (0x1)
        64    %31 = iadd %3, %30
        16    %32 = @load_global (%31) (access=none, align_mul=2, align_offset=0)
        32    %33 = u2u32 %32
        32    %34 = ishl %33, %23 (0x10)
        32    %35 = fadd %26, %34
        64    %36 = ishl %29, %18 (0x2)
        64    %37 = iadd %0, %36
                    @store_global (%35, %37) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b8
    } else {
        block b7:  // preds: b0, succs: b8
    }
    block b8:  // preds: b6 b7, succs: b9
    block b9:
}

