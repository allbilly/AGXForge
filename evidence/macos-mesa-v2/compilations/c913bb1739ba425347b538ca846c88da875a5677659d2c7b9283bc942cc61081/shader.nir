shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    64     %2 = @load_preamble (base=8)
    32x3   %3 = @load_global_invocation_id
    32     %4 = load_const (0x00000300 = 768)
    1      %5 = ult %3.x, %4 (0x300)
                // succs: b1 b2
    if %5 {
        block b1:   // preds: b0
        32     %6 = @load_global (%2) (access=none, align_mul=4, align_offset=0)
        32     %7 = imul %6, %4 (0x300)
        32     %8 = iadd %7, %3.x
        64     %9 = u2u64 %8
        32    %10 = load_const (0x00000002)
        64    %11 = ishl %9, %10 (0x2)
        64    %12 = iadd %1, %11
        32    %13 = @load_global (%12) (access=none, align_mul=4, align_offset=0)
        64    %14 = u2u64 %3.x
        64    %15 = ishl %14, %10 (0x2)
        64    %16 = iadd %0, %15
                    @store_global (%13, %16) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b3
    } else {
        block b2:  // preds: b0, succs: b3
    }
    block b3:  // preds: b1 b2, succs: b4
    block b4:
}

