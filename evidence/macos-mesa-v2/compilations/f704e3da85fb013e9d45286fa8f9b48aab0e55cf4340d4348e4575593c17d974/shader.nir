shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    64     %2 = @load_preamble (base=8)
    32x3   %3 = @load_global_invocation_id
    32     %4 = load_const (0x00000021 = 33)
    1      %5 = ult %3.x, %4 (0x21)
                // succs: b1 b7
    if %5 {
        block b1:   // preds: b0
        32     %6 = load_const (0x00000000 = 0.000000)
        32     %7 = load_const (0x00000041 = 65)
        32     %8 = imul %3.x, %7 (0x41)
                    // succs: b2
        loop {
            block b2:   // preds: b1 b5
            32     %9 = phi b1: %6 (0x0), b5: %23
            32    %10 = phi b1: %6 (0x0), b5: %24
            32    %11 = iadd %8, %10
            32    %12 = load_const (0x00000001)
            64    %13 = u2u64 %11
            64    %14 = ishl %13, %12 (0x1)
            64    %15 = iadd %2, %14
            16    %16 = @load_global (%15) (access=none, align_mul=2, align_offset=0)
            32    %17 = load_const (0x00000002)
            64    %18 = u2u64 %10
            64    %19 = ishl %18, %17 (0x2)
            64    %20 = iadd %1, %19
            32    %21 = @load_global (%20) (access=none, align_mul=4, align_offset=0)
            32    %22 = f2f32 %16
            32    %23 = ffma %22, %21, %9
            32    %24 = iadd %10, %12 (0x1)
            1     %25 = uge %24, %7 (0x41)
                        // succs: b3 b4
            if %25 {
                block b3:// preds: b2
                break
                // succs: b6
            } else {
                block b4:  // preds: b2, succs: b5
            }
            block b5:  // preds: b4, succs: b2
        }
        block b6:   // preds: b3
        64    %26 = u2u64 %3.x
        64    %27 = ishl %26, %17 (0x2)
        64    %28 = iadd %0, %27
                    @store_global (%23, %28) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b8
    } else {
        block b7:  // preds: b0, succs: b8
    }
    block b8:  // preds: b6 b7, succs: b9
    block b9:
}

