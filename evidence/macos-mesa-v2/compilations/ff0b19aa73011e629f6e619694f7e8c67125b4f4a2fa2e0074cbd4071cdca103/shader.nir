shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    64     %2 = @load_preamble (base=8)
    32x3   %3 = @load_global_invocation_id
    32     %4 = load_const (0x00000000 = 0.000000)
    1      %5 = ieq %3.x, %4 (0x0)
                // succs: b1 b7
    if %5 {
        block b1:   // preds: b0
        32     %6 = @load_global (%2) (access=none, align_mul=4, align_offset=0)
        32     %7 = load_const (0x3c7c0fc1 = 0.015385)
        32     %8 = fmul %6, %7 (0.015385)
        32     %9 = load_const (0x00000001)
        32    %10 = load_const (0x00000002)
                    // succs: b2
        loop {
            block b2:   // preds: b1 b5
            32    %11 = phi b1: %4 (0x0), b5: %19
            32    %12 = phi b1: %4 (0x0), b5: %21
            64    %13 = u2u64 %12
            64    %14 = ishl %13, %10 (0x2)
            64    %15 = iadd %1, %14
            32    %16 = @load_global (%15) (access=none, align_mul=4, align_offset=0)
            32    %17 = fneg %8
            32    %18 = fadd %16, %17
            32    %19 = ffma %18, %18, %11
            32    %20 = load_const (0x00000041 = 65)
            32    %21 = iadd %12, %9 (0x1)
            1     %22 = uge %21, %20 (0x41)
                        // succs: b3 b4
            if %22 {
                block b3:// preds: b2
                break
                // succs: b6
            } else {
                block b4:  // preds: b2, succs: b5
            }
            block b5:  // preds: b4, succs: b2
        }
        block b6:   // preds: b3
                    @store_global (%8, %0) (wrmask=x, access=none, align_mul=4, align_offset=0)
        64    %23 = load_const (0x0000000000000004)
        64    %24 = iadd %0, %23 (0x4)
        32    %25 = fmul %19, %7 (0.015385)
        32    %26 = load_const (0x3727c5ac = 0.000010)
        32    %27 = fadd %25, %26 (0.000010)
        32    %28 = frsq %27
                    @store_global (%28, %24) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b8
    } else {
        block b7:  // preds: b0, succs: b8
    }
    block b8:  // preds: b6 b7, succs: b9
    block b9:
}

