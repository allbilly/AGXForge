shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    64     %2 = @load_preamble (base=8)
    32x3   %3 = @load_global_invocation_id
    32     %4 = load_const (0x00000080 = 128)
    1      %5 = ult %3.x, %4 (0x80)
                // succs: b1 b2
    if %5 {
        block b1:   // preds: b0
        64     %6 = load_const (0x0000000000000004)
        64     %7 = iadd %2, %6 (0x4)
        32     %8 = @load_global (%7) (access=none, align_mul=4, align_offset=0)
        32     %9 = load_const (0x00000007)
        32    %10 = ishl %8, %9 (0x7)
        32    %11 = iadd %10, %3.x
        64    %12 = u2u64 %3.x
        32    %13 = load_const (0x00000002)
        64    %14 = ishl %12, %13 (0x2)
        64    %15 = iadd %1, %14
        32    %16 = @load_global (%15) (access=none, align_mul=4, align_offset=0)
        64    %17 = u2u64 %11
        64    %18 = ishl %17, %13 (0x2)
        64    %19 = iadd %0, %18
                    @store_global (%16, %19) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b3
    } else {
        block b2:  // preds: b0, succs: b3
    }
    block b3:  // preds: b1 b2, succs: b4
    block b4:
}

