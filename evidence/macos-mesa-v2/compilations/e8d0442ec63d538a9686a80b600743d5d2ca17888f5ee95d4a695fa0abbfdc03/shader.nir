        32    %50 = fadd %45, %49
        32    %51 = fmul %22, %44
        32    %52 = fmul %16, %47
        32    %53 = fadd %51, %52
        32    %54 = load_const (0x0000003f = 63)
        32    %55 = iand %4.x, %54 (0x3f)
