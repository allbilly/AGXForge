        64    %21 = iadd %1, %20
        32    %22 = @load_global (%21) (access=none, align_mul=4, align_offset=0)
        64    %23 = load_const (0x0000000000000004)
        64    %24 = iadd %3, %23 (0x4)
        32    %25 = @load_global (%24) (access=none, align_mul=4, align_offset=0)
        64    %26 = u2u64 %8
        64    %27 = ishl %26, %12 (0x2)
        64    %28 = iadd %2, %27
        32    %29 = @load_global (%28) (access=none, align_mul=4, align_offset=0)
        32    %30 = load_const (0x3e22f983 = 0.159155)
        32    %31 = u2f32 %25
        32    %32 = fmul %31, %30 (0.159155)
        32    %33 = fmul %32, %29
        32    %34 = ffloor %33
        32    %35 = fneg %34
        32    %36 = fadd %33, %35
        32    %37 = load_const (0x3e800000 = 0.250000)
        32    %38 = fadd %33, %37 (0.250000)
        32    %39 = ffloor %38
        32    %40 = fneg %39
