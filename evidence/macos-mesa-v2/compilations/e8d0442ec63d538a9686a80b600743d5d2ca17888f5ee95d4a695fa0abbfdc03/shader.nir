        32    %42 = load_const (0x40800000 = 4.000000)
        32    %43 = fmul %41, %42 (4.000000)
        32    %44 = fsin_agx %43
        32    %45 = fmul %16, %44
        32    %46 = fmul %36, %42 (4.000000)
        32    %47 = fsin_agx %46
        32    %48 = fmul %22, %47
