shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    64     %2 = @load_preamble (base=8)
    64     %3 = @load_preamble (base=12)
    64     %4 = @load_preamble (base=16)
    32x3   %5 = @load_global_invocation_id
    32     %6 = load_const (0x00000300 = 768)
    1      %7 = ult %5.x, %6 (0x300)
                // succs: b1 b2
    if %7 {
        block b1:   // preds: b0
        32     %8 = load_const (0x00000002)
        64     %9 = u2u64 %5.x
        64    %10 = ishl %9, %8 (0x2)
        64    %11 = iadd %1, %10
        32    %12 = @load_global (%11) (access=none, align_mul=4, align_offset=0)
        32    %13 = @load_global (%4) (access=none, align_mul=4, align_offset=0)
        32    %14 = fneg %13
        32    %15 = fadd %12, %14
        64    %16 = load_const (0x0000000000000004)
        64    %17 = iadd %4, %16 (0x4)
        32    %18 = @load_global (%17) (access=none, align_mul=4, align_offset=0)
        32    %19 = fmul %15, %18
        64    %20 = iadd %2, %10
        32    %21 = @load_global (%20) (access=none, align_mul=4, align_offset=0)
        32    %22 = fmul %19, %21
        64    %23 = iadd %3, %10
        32    %24 = @load_global (%23) (access=none, align_mul=4, align_offset=0)
        32    %25 = fadd %22, %24
        64    %26 = iadd %0, %10
                    @store_global (%25, %26) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b3
    } else {
        block b2:  // preds: b0, succs: b3
    }
    block b3:  // preds: b1 b2, succs: b4
    block b4:
}

