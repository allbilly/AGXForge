shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    32x3   %2 = @load_global_invocation_id
    32     %3 = load_const (0x00000003)
    1      %4 = ult %2.x, %3 (0x3)
                // succs: b1 b7
    if %4 {
        block b1:   // preds: b0
        32     %5 = load_const (0x00000000 = 0.000000)
        32     %6 = load_const (0x00000041 = 65)
        32     %7 = imul %2.x, %6 (0x41)
                    // succs: b2
        loop {
            block b2:   // preds: b1 b5
            32     %8 = phi b1: %5 (0x0), b5: %16
            32     %9 = phi b1: %5 (0x0), b5: %18
            32    %10 = iadd %7, %9
            32    %11 = load_const (0x00000002)
            64    %12 = u2u64 %10
            64    %13 = ishl %12, %11 (0x2)
            64    %14 = iadd %1, %13
            32    %15 = @load_global (%14) (access=none, align_mul=4, align_offset=0)
            32    %16 = fadd %8, %15
            32    %17 = load_const (0x00000001)
            32    %18 = iadd %9, %17 (0x1)
            1     %19 = uge %18, %6 (0x41)
                        // succs: b3 b4
            if %19 {
                block b3:// preds: b2
                break
                // succs: b6
            } else {
                block b4:  // preds: b2, succs: b5
            }
            block b5:  // preds: b4, succs: b2
        }
        block b6:   // preds: b3
        64    %20 = u2u64 %2.x
        64    %21 = ishl %20, %11 (0x2)
        64    %22 = iadd %0, %21
                    @store_global (%16, %22) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b8
    } else {
        block b7:  // preds: b0, succs: b8
    }
    block b8:  // preds: b6 b7, succs: b9
    block b9:
}

