shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    32x3   %1 = @load_global_invocation_id
    32     %2 = load_const (0x00000041 = 65)
    1      %3 = ult %1.x, %2 (0x41)
                // succs: b1 b2
    if %3 {
        block b1:   // preds: b0
        32x3   %4 = @load_workgroup_id
        32     %5 = load_const (0x00000002)
        64     %6 = u2u64 %1.x
        64     %7 = ishl %6, %5 (0x2)
        64     %8 = iadd %0, %7
        32     %9 = mov %4.x
                    @store_global (%9, %8) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b3
    } else {
        block b2:  // preds: b0, succs: b3
    }
    block b3:  // preds: b1 b2, succs: b4
    block b4:
}

