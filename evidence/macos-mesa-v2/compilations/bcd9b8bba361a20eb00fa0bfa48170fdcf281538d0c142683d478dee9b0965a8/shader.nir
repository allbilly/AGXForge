shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    32x3   %2 = @load_global_invocation_id
    32     %3 = load_const (0x00000000)
    1      %4 = ieq %2.x, %3 (0x0)
                // succs: b1 b7
    if %4 {
        block b1:   // preds: b0
        32     %5 = load_const (0xff800000 = -inf)
        32     %6 = load_const (0x00000001)
                    // succs: b2
        loop {
            block b2:   // preds: b1 b5
            32     %7 = phi b1: %3 (0x0), b5: %16
            32     %8 = phi b1: %5 (-inf), b5: %17
            32     %9 = phi b1: %3 (0x0), b5: %19
            32    %10 = load_const (0x00000002)
            64    %11 = u2u64 %9
            64    %12 = ishl %11, %10 (0x2)
            64    %13 = iadd %1, %12
            32    %14 = @load_global (%13) (access=none, align_mul=4, align_offset=0)
            1     %15 = flt %8, %14
            32    %16 = bcsel %15, %9, %7
            32    %17 = bcsel %15, %14, %8
            32    %18 = load_const (0x0000c451 = 50257)
            32    %19 = iadd %9, %6 (0x1)
            1     %20 = uge %19, %18 (0xc451)
                        // succs: b3 b4
            if %20 {
                block b3:// preds: b2
                break
                // succs: b6
            } else {
                block b4:  // preds: b2, succs: b5
            }
            block b5:  // preds: b4, succs: b2
        }
        block b6:   // preds: b3
        64    %21 = u2u64 %2.x
        64    %22 = ishl %21, %10 (0x2)
        64    %23 = iadd %0, %22
                    @store_global (%16, %23) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b8
    } else {
        block b7:  // preds: b0, succs: b8
    }
    block b8:  // preds: b6 b7, succs: b9
    block b9:
}

