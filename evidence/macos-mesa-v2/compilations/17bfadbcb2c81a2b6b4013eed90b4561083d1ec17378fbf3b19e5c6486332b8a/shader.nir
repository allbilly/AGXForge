shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    32x3   %2 = @load_global_invocation_id
    32     %3 = load_const (0x00000000)
    1      %4 = ieq %2.x, %3 (0x0)
                // succs: b1 b2
    if %4 {
        block b1:   // preds: b0
        32     %5 = @load_global (%1) (access=none, align_mul=4, align_offset=0)
        64     %6 = u2u64 %2.x
        32     %7 = load_const (0x00000002)
        64     %8 = ishl %6, %7 (0x2)
        64     %9 = iadd %0, %8
        32    %10 = load_const (0x3c7c0fc1 = 0.015385)
        32    %11 = fmul %5, %10 (0.015385)
        32    %12 = load_const (0x358637bd = 0.000001)
        32    %13 = fadd %11, %12 (0.000001)
        32    %14 = frsq %13
                    @store_global (%14, %9) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b3
    } else {
        block b2:  // preds: b0, succs: b3
    }
    block b3:  // preds: b1 b2, succs: b4
    block b4:
}

