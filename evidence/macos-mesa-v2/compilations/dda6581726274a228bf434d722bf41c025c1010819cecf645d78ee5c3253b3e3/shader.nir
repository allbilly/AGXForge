shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    64     %2 = @load_preamble (base=8)
    32x3   %3 = @load_global_invocation_id
    32     %4 = load_const (0x00000041 = 65)
    1      %5 = ult %3.x, %4 (0x41)
                // succs: b1 b2
    if %5 {
        block b1:   // preds: b0
        32     %6 = @load_global (%2) (access=none, align_mul=4, align_offset=0)
        32     %7 = imul %6, %4 (0x41)
        32     %8 = iadd %7, %3.x
        32     %9 = load_const (0x00000001)
        64    %10 = u2u64 %8
        64    %11 = ishl %10, %9 (0x1)
        64    %12 = iadd %1, %11
        16    %13 = @load_global (%12) (access=none, align_mul=2, align_offset=0)
        64    %14 = u2u64 %3.x
        32    %15 = load_const (0x00000002)
        64    %16 = ishl %14, %15 (0x2)
        64    %17 = iadd %0, %16
        32    %18 = load_const (0x00000010 = 16)
        32    %19 = u2u32 %13
        32    %20 = ishl %19, %18 (0x10)
                    @store_global (%20, %17) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b3
    } else {
        block b2:  // preds: b0, succs: b3
    }
    block b3:  // preds: b1 b2, succs: b4
    block b4:
}

