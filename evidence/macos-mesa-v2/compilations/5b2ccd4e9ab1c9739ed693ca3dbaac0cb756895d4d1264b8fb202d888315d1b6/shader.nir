shader: MESA_SHADER_COMPUTE
name: AGXForge Mesa
internal: true
workgroup_size: 32, 1, 1
max_subgroup_size: 128
min_subgroup_size: 1
flrp_lowered: true
io_lowered: true
decl_function main () (entrypoint)

impl main {
    block b0:   // preds:
    64     %0 = @load_preamble (base=0)
    64     %1 = @load_preamble (base=4)
    64     %2 = @load_preamble (base=8)
    64     %3 = @load_preamble (base=12)
    64     %4 = @load_preamble (base=16)
    32x3   %5 = @load_global_invocation_id
    32     %6 = load_const (0x00000180 = 384)
    1      %7 = ult %5.x, %6 (0x180)
                // succs: b1 b7
    if %7 {
        block b1:   // preds: b0
        32     %8 = load_const (0x00000002)
        32     %9 = load_const (0x00000005)
        32    %10 = ushr %5.x, %9 (0x5)
        64    %11 = u2u64 %10
        64    %12 = ishl %11, %8 (0x2)
        64    %13 = iadd %3, %12
        32    %14 = @load_global (%13) (access=none, align_mul=4, align_offset=0)
        32    %15 = load_const (0x0000000c = 12)
        32    %16 = load_const (0x0000001f = 31)
        32    %17 = iand %5.x, %16 (0x1f)
        32    %18 = imul %17, %15 (0xc)
        32    %19 = iadd %18, %14
        32    %20 = load_const (0x00000000 = 0.000000)
        32    %21 = load_const (0x00000040 = 64)
        32    %22 = load_const (0x00000006)
        32    %23 = ishl %10, %22 (0x6)
        32    %24 = ishl %19, %22 (0x6)
                    // succs: b2
        loop {
            block b2:   // preds: b1 b5
            32    %25 = phi b1: %20 (0x0), b5: %37
            32    %26 = phi b1: %20 (0x0), b5: %39
            32    %27 = iadd %23, %26
            64    %28 = u2u64 %27
            64    %29 = ishl %28, %8 (0x2)
            64    %30 = iadd %1, %29
            32    %31 = @load_global (%30) (access=none, align_mul=4, align_offset=0)
            32    %32 = iadd %24, %26
            64    %33 = u2u64 %32
            64    %34 = ishl %33, %8 (0x2)
            64    %35 = iadd %2, %34
            32    %36 = @load_global (%35) (access=none, align_mul=4, align_offset=0)
            32    %37 = ffma %31, %36, %25
            32    %38 = load_const (0x00000001)
            32    %39 = iadd %26, %38 (0x1)
            1     %40 = uge %39, %21 (0x40)
                        // succs: b3 b4
            if %40 {
                block b3:// preds: b2
                break
                // succs: b6
            } else {
                block b4:  // preds: b2, succs: b5
            }
            block b5:  // preds: b4, succs: b2
        }
        block b6:   // preds: b3
        64    %41 = load_const (0x0000000000000004)
        64    %42 = iadd %4, %41 (0x4)
        32    %43 = @load_global (%42) (access=none, align_mul=4, align_offset=0)
        1     %44 = ult %43, %17
        32    %45 = load_const (0x3e000000 = 0.125000)
        32    %46 = fmul %37, %45 (0.125000)
        32    %47 = load_const (0xff800000 = -inf)
        32    %48 = bcsel %44, %47 (0xff800000), %46
        64    %49 = u2u64 %5.x
        64    %50 = ishl %49, %8 (0x2)
        64    %51 = iadd %0, %50
                    @store_global (%48, %51) (wrmask=x, access=none, align_mul=4, align_offset=0)
                    // succs: b8
    } else {
        block b7:  // preds: b0, succs: b8
    }
    block b8:  // preds: b6 b7, succs: b9
    block b9:
}

